# Copied to .env by ./start.sh on first run (secrets are generated for you).

N8N_VERSION=2.44.6
GENERIC_TIMEZONE=Asia/Kolkata

# --- Local (default) ---------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_PORT_SUFFIX=:5678
N8N_BIND_ADDRESS=127.0.0.1
N8N_SECURE_COOKIE=false

# --- Server with a domain (use with: docker compose --profile https up -d) ---
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_PUBLIC_PORT_SUFFIX=
# N8N_BIND_ADDRESS=127.0.0.1
# N8N_SECURE_COOKIE=true

# --- Secrets (generated by start.sh if left as CHANGE_ME) ---------------------
# Back up N8N_ENCRYPTION_KEY: without it, stored credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=CHANGE_ME
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME

# --- Newsletter digest demo (optional; read on first boot only) ----------------
# Pre-creates the n8n credentials so you only have to click "Connect" for Gmail.
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
